# =================================================================
# RoomMates Backend Environment Configuration (.env.example)
# Note: Keep all real secrets ONLY on the backend. Never commit .env to Git!
# =================================================================

# Server & Network Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# Database Connection (Leave empty for zero-config in-memory MongoDB in dev/test)
# Or provide your MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/roommates?retryWrites=true&w=majority
MONGO_URI=
MONGODB_URI=

# JWT & Session Security (Use at least 32 random characters in production)
JWT_SECRET=replace_with_an_adequately_random_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
OTP_SECRET=replace_with_a_secure_hmac_secret_for_otp_hashing

# -----------------------------------------------------------------
# Brevo Official Transactional Email Configuration (Required)
# API Documentation: https://developers.brevo.com/reference/sendtransacemail
# -----------------------------------------------------------------
# 1. Sign up at https://app.brevo.com/
# 2. Generate API Key: Settings -> Senders, Domains & Dedicated IPs -> SMTP & API -> API Keys
# 3. Verify Sender Email: Settings -> Senders -> Add a sender (e.g. you@yourdomain.com)
BREVO_API_KEY=xkeysib-your_brevo_api_key_v3_here
BREVO_SENDER_EMAIL=verified_sender_email@yourdomain.com
BREVO_SENDER_NAME=RoomMates Expense Tracker

# -----------------------------------------------------------------
# Google OAuth 2.0 (Optional for Google Sign-In)
# -----------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
