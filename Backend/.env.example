# =================================================================
# RoomMates Backend Environment Configuration
# =================================================================

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Leave blank or set to 'memory' for zero-config in-memory MongoDB)
# Or paste your MongoDB Atlas Connection String:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/roommates?retryWrites=true&w=majority
MONGODB_URI=

# Security & Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# -----------------------------------------------------------------
# Google OAuth 2.0 / Identity Services Credentials
# -----------------------------------------------------------------
# 1. Create a project at https://console.cloud.google.com/
# 2. Go to APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID (Web Application)
# 3. Add Authorized JavaScript Origin: http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# -----------------------------------------------------------------
# Real Email Delivery Configuration (Password Resets & Notifications)
# -----------------------------------------------------------------
# Option A: Resend HTTP API (Recommended & 100% Reliable for Render / Cloud Hosting)
# 1. Sign up free at https://resend.com/
# 2. Get API key from https://resend.com/api-keys
# 3. For testing, use the default sender 'RoomMates <onboarding@resend.dev>'
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=RoomMates <onboarding@resend.dev>

# Option B: Standard SMTP Server / Gmail (e.g. Brevo, SendGrid, Mailgun)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_login
# SMTP_PASS=your_smtp_password
# SMTP_FROM=RoomMates Support <no-reply@yourdomain.com>

# Option C: Gmail App Password
# GMAIL_USER=your_gmail_address@gmail.com
# GMAIL_APP_PASSWORD=your_16_character_google_app_password

