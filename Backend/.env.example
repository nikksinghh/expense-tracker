# =================================================================
# RoomMates Backend Environment Configuration
# =================================================================

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Leave blank or set to 'memory' for zero-config in-memory MongoDB)
# Or paste your MongoDB Atlas Connection String:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/roommates?retryWrites=true&w=majority
MONGODB_URI=

# Security & Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# -----------------------------------------------------------------
# Google OAuth 2.0 / Identity Services Credentials
# -----------------------------------------------------------------
# 1. Create a project at https://console.cloud.google.com/
# 2. Go to APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID (Web Application)
# 3. Add Authorized JavaScript Origin: http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# -----------------------------------------------------------------
# Real SMTP Email Configuration for Password Resets & Notifications
# -----------------------------------------------------------------
# Option A: Gmail SMTP using Google App Password (Recommended)
# Create a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password

# Option B: Standard SMTP Server (e.g., SendGrid, Mailgun, Brevo, AWS SES)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_api_key
# SMTP_FROM=RoomMates Support <support@yourdomain.com>
